package HelpChatAI;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Ethea HelpChatAI Engine (framework independent)'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  MarkdownProcessor;

contains
  HelpChatAI.Types in '..\..\source\HelpChatAI.Types.pas',
  HelpChatAI.Messages in '..\..\source\HelpChatAI.Messages.pas',
  HelpChatAI.Assistant in '..\..\source\HelpChatAI.Assistant.pas',
  HelpChatAI.Settings in '..\..\source\HelpChatAI.Settings.pas',
  HelpChatAI.Actions in '..\..\source\HelpChatAI.Actions.pas',
  HelpChatAI.Provider in '..\..\source\HelpChatAI.Provider.pas',
  HelpChatAI.Provider.Sse in '..\..\source\HelpChatAI.Provider.Sse.pas',
  HelpChatAI.Store in '..\..\source\HelpChatAI.Store.pas',
  HelpChatAI.DocIndex in '..\..\source\HelpChatAI.DocIndex.pas',
  HelpChatAI.DocPages in '..\..\source\HelpChatAI.DocPages.pas',
  HelpChatAI.Html in '..\..\source\HelpChatAI.Html.pas',
  HelpChatAI.Runner in '..\..\source\HelpChatAI.Runner.pas',
  HelpChatAI.Provider.DocSearch in '..\..\source\HelpChatAI.Provider.DocSearch.pas',
  HelpChatAI.Provider.Claude in '..\..\source\HelpChatAI.Provider.Claude.pas',
  HelpChatAI.Provider.OpenAI in '..\..\source\HelpChatAI.Provider.OpenAI.pas',
  HelpChatAI.Provider.Gemini in '..\..\source\HelpChatAI.Provider.Gemini.pas',
  HelpChatAI.Diagnostics in '..\..\source\HelpChatAI.Diagnostics.pas',
  HelpChatAI.Engine in '..\..\source\HelpChatAI.Engine.pas',
  HelpChatAI.IndexBuilder in '..\..\source\HelpChatAI.IndexBuilder.pas',
  HelpChatAI.Transport in '..\..\source\HelpChatAI.Transport.pas',
  HelpChatAI.Panel in '..\..\source\HelpChatAI.Panel.pas',
  HelpChatAI.Theme in '..\..\source\HelpChatAI.Theme.pas',
  HelpChatAI.HelpViewer in '..\..\source\HelpChatAI.HelpViewer.pas';

end.
