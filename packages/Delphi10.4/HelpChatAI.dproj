<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{8B2E4F61-3A7C-4D95-B1E8-6F0C9A2D7E31}</ProjectGuid>
        <MainSource>HelpChatAI.dpk</MainSource>
        <ProjectVersion>19.2</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>3</TargetedPlatforms>
        <AppType>Package</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>..\..\Lib\Delphi10.4\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <SanitizedProjectName>HelpChatAI</SanitizedProjectName>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <VerInfo_Keys>CompanyName=Ethea S.r.l.;FileDescription=HelpChatAI Engine;FileVersion=1.0.0.0;InternalName=;LegalCopyright=Copyright (c) Ethea S.r.l.;LegalTrademarks=;OriginalFilename=;ProgramID=;ProductName=HelpChatAI;ProductVersion=1.0;Comments=</VerInfo_Keys>
        <DCC_Description>Ethea HelpChatAI Engine (framework independent)</DCC_Description>
        <RuntimeOnlyPackage>true</RuntimeOnlyPackage>
        <DllSuffix>$(Auto)</DllSuffix>
        <DCC_OutputNeverBuildDcps>true</DCC_OutputNeverBuildDcps>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>true</DCC_RangeChecking>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="dbrtl.dcp"/>
        <DCCReference Include="MarkdownProcessor.dcp"/>
        <DCCReference Include="..\..\source\HelpChatAI.Types.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Log.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Messages.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Assistant.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.UiState.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Icons.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Commands.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Skills.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Skills.Screen.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Settings.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Actions.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Attachments.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Pdf.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Provider.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Provider.Sse.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Store.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.DocIndex.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.DocPages.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Html.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Runner.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Provider.DocSearch.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Provider.Claude.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Provider.OpenAI.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Provider.Gemini.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Diagnostics.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.ConfigController.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Engine.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.IndexBuilder.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Transport.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Panel.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.Theme.pas"/>
        <DCCReference Include="..\..\source\HelpChatAI.HelpViewer.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">HelpChatAI.dpk</Source>
                </Source>
                <Excluded_Packages/>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
