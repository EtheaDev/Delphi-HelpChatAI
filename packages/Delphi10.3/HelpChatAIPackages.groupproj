            <Configurations>Release</Configurations>
            <Platforms>Win64</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
        <BuildGroupProject Include="HelpChatAIServer.dproj">
            <ProjectGuid>{D4F0A2B7-6C19-4E83-A5D2-8B3E7F1C9A46}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win64</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
    </ItemGroup>
    <ItemGroup Condition="'$(BuildGroup)'=='Win32_All'">
        <BuildGroupProject Include="..\..\Ext\MarkdownProcessor\Packages\D10.3\MarkdownProcessor.dproj">
            <ProjectGuid>{6283D84E-2244-48DB-BDB7-9B4FA20D62E0}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win32</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
        <BuildGroupProject Include="HelpChatAI.dproj">
            <ProjectGuid>{8B2E4F61-3A7C-4D95-B1E8-6F0C9A2D7E31}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win32</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
        <BuildGroupProject Include="HelpChatAIServer.dproj">
            <ProjectGuid>{D4F0A2B7-6C19-4E83-A5D2-8B3E7F1C9A46}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win32</Platforms>
            <Enabled>True</Enabled>
        </BuildGroupProject>
    </ItemGroup>
</Project>
