<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{DCF3DB5F-FC01-4F3E-9BCB-3FBCCF9D8A15}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\..\Ext\MarkdownProcessor\Packages\D10.3\MarkdownProcessor.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="HelpChatAI.dproj">
            <Dependencies>..\..\Ext\MarkdownProcessor\Packages\D10.3\MarkdownProcessor.dproj</Dependencies>
        </Projects>
        <Projects Include="HelpChatAIServer.dproj">
            <Dependencies>HelpChatAI.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="MarkdownProcessor">
        <MSBuild Projects="..\..\Ext\MarkdownProcessor\Packages\D10.3\MarkdownProcessor.dproj"/>
    </Target>
    <Target Name="MarkdownProcessor:Clean">
        <MSBuild Projects="..\..\Ext\MarkdownProcessor\Packages\D10.3\MarkdownProcessor.dproj" Targets="Clean"/>
    </Target>
    <Target Name="MarkdownProcessor:Make">
        <MSBuild Projects="..\..\Ext\MarkdownProcessor\Packages\D10.3\MarkdownProcessor.dproj" Targets="Make"/>
    </Target>
    <Target Name="HelpChatAI" DependsOnTargets="MarkdownProcessor">
        <MSBuild Projects="HelpChatAI.dproj"/>
    </Target>
    <Target Name="HelpChatAI:Clean" DependsOnTargets="MarkdownProcessor:Clean">
        <MSBuild Projects="HelpChatAI.dproj" Targets="Clean"/>
    </Target>
    <Target Name="HelpChatAI:Make" DependsOnTargets="MarkdownProcessor:Make">
        <MSBuild Projects="HelpChatAI.dproj" Targets="Make"/>
    </Target>
    <Target Name="HelpChatAIServer" DependsOnTargets="HelpChatAI">
        <MSBuild Projects="HelpChatAIServer.dproj"/>
    </Target>
    <Target Name="HelpChatAIServer:Clean" DependsOnTargets="HelpChatAI:Clean">
        <MSBuild Projects="HelpChatAIServer.dproj" Targets="Clean"/>
    </Target>
    <Target Name="HelpChatAIServer:Make" DependsOnTargets="HelpChatAI:Make">
        <MSBuild Projects="HelpChatAIServer.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="MarkdownProcessor;HelpChatAI;HelpChatAIServer"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="MarkdownProcessor:Clean;HelpChatAI:Clean;HelpChatAIServer:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="MarkdownProcessor:Make;HelpChatAI:Make;HelpChatAIServer:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
    <ItemGroup Condition="'$(BuildGroup)'=='Win64_All'">
        <BuildGroupProject Include="..\..\Ext\MarkdownProcessor\Packages\D10.3\MarkdownProcessor.dproj">
            <ProjectGuid>{6283D84E-2244-48DB-BDB7-9B4FA20D62E0}</ProjectGuid>
            <Configurations>Release</Configurations>
            <Platforms>Win64</Platforms>
