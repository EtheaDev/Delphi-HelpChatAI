    object SchedulerTab: TTabItem
      HelpType = htKeyword
      HelpKeyword = 'Scheduler dei Report'
      IsSelected = True
      Size.Width = 140.000000000000000000
      Size.Height = 26.000000000000000000
      Size.PlatformDefault = False
      TabOrder = 0
      Text = 'Scheduler dei Report'
      object SchedulerMemo: TMemo
        Lines.Strings = (
          'This screen stands for the "Scheduler dei Report" function of the manual.'
          ''
          'Press F1 (or the "F1 - this screen" button): the chat opens with a question about this'
          'screen. The component reads the HelpKeyword of the active tab item ("Scheduler dei Report")'
          'and the retriever uses it to find the right page of the documentation index.'
          ''
          'The bubble in the bottom-right corner opens the chat for a free question.'
          ''
          'Providers: "docsearch" answers from the index without any key; "claude" needs an API key'
          'in %APPDATA%\HelpChatAI\helpchat.json (shared by all HelpChatAI apps)  ->  { "Claude": { "ApiKey": "sk-ant-..." } }'
          'or in %APPDATA%\HelpChatAIFmxDemo\helpchat.json, or in the ANTHROPIC_API_KEY environment variable.')
        ReadOnly = True
        Align = Client
        Size.Width = 456.000000000000000000
        Size.Height = 408.000000000000000000
        Size.PlatformDefault = False
        TabOrder = 0
      end
    end
    object MailTab: TTabItem
      HelpType = htKeyword
      HelpKeyword = 'Configurazione e gestione delle e-mail'
      IsSelected = False
      Size.Width = 110.000000000000000000
      Size.Height = 26.000000000000000000
      Size.PlatformDefault = False
      TabOrder = 0
      Text = 'Server di posta'
      object MailMemo: TMemo
        Lines.Strings = (
          'This screen stands for the e-mail configuration (PARAMETRI - Server di posta).'
          ''
          'Its HelpKeyword is "Configurazione e gestione delle e-mail": F1 here asks the assistant'
          'about SMTP configuration and the answer cites the page 320000.html of the manual.'
          ''
          'Try, in Italian: "come configuro il server SMTP?" or "come invio un report via e-mail?"')
        ReadOnly = True
        Align = Client
        Size.Width = 456.000000000000000000
        Size.Height = 408.000000000000000000
        Size.PlatformDefault = False
        TabOrder = 0
      end
    end
  end
  object HelpChat: TFmxHelpChatAI
    Settings.Provider = 'docsearch'
