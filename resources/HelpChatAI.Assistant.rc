/* HelpChat assistant icons, compiled into source\HelpChatAI.Assistant.res by
   Tools\BuildResources.cmd and linked by Vcl.HelpChatAI.Bubble.pas.

   One RCDATA entry per icon and size: TImageCollection.Add(name, HInstance,
   '<NAME>', ['_16', '_18', ...]) loads them all as the sources of one image,
   so a TVirtualImageList can pick the size the current DPI asks for.
   The PNGs are generated from Images\<name>.svg (see Tools\BuildIcons.cmd). */

AIASSISTANT_MALE_16    RCDATA "..\\Images\\AIAssistant_Male_16.png"
